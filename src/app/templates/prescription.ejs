<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8" />
    <title>Prescription</title>

    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
            background-color: #f4f6f8;
        }

        .container {
            width: 600px;
            margin: 20px auto;
            background: #ffffff;
            padding: 20px;
            border-radius: 8px;
        }

        .header {
            text-align: center;
            border-bottom: 1px solid #ddd;
            padding-bottom: 15px;
        }

        .header h2 {
            margin: 0;
            color: #2c3e50;
        }

        .section {
            margin: 20px 0;
        }

        .section h3 {
            margin-bottom: 8px;
            color: #34495e;
        }

        .text {
            margin: 4px 0;
            color: #555;
        }

        .footer {
            margin-top: 20px;
            border-top: 1px solid #ddd;
            text-align: center;
            padding-top: 10px;
            font-size: 13px;
            color: #999;
        }

        .highlight {
            font-weight: bold;
        }

        .note {
            margin-top: 10px;
        }
    </style>
</head>

<body>

    <div class="container">

        <!-- Header -->
        <div class="header">
            <h2>Medical Prescription</h2>
            <p class="text">Prescription ID: <%= prescriptionId %>
            </p>
        </div>

        <!-- Greeting -->
        <div class="section">
            <p class="text">
                Dear <span class="highlight">
                    <%= patientName %>
                </span>,
            </p>
            <p class="text">
                You have received a new prescription from your doctor.
            </p>
        </div>

        <!-- Doctor Info -->
        <div class="section">
            <h3>Doctor Information</h3>
            <p class="text"><span class="highlight">Name:</span> Dr. <%= doctorName %>
            </p>
            <p class="text"><span class="highlight">Email:</span>
                <%= doctorEmail %>
            </p>
            <p class="text"><span class="highlight">Specialization:</span>
                <%= specialization %>
            </p>
        </div>

        <!-- Patient Info -->
        <div class="section">
            <h3>Patient Information</h3>
            <p class="text"><span class="highlight">Name:</span>
                <%= patientName %>
            </p>
            <p class="text"><span class="highlight">Email:</span>
                <%= patientEmail %>
            </p>
        </div>

        <!-- Appointment -->
        <div class="section">
            <h3>Appointment Details</h3>
            <p class="text">
                <span class="highlight">Appointment Date:</span>
                <%= new Date(appointmentDate).toLocaleDateString() %>
            </p>
            <p class="text">
                <span class="highlight">Prescription Created:</span>
                <%= new Date(createdAt).toLocaleDateString() %>
            </p>
        </div>

        <!-- Instructions -->
        <div class="section">
            <h3>Instructions</h3>
            <p class="text">
                <%= instructions %>
            </p>
        </div>

        <!-- Follow-up -->
        <div class="section">
            <h3>Follow-Up Date</h3>
            <p class="text">
                <%= new Date(followUpDate).toLocaleDateString() %>
            </p>
        </div>

        <!-- Attachment Note -->
        <div class="section note">
            <p class="text">📎 Your prescription PDF is attached with this email.</p>
        </div>

        <!-- Footer -->
        <div class="footer">
            <p>This is an automated message. Please do not reply.</p>
            <p>© <%= new Date().getFullYear() %> Medical System</p>
        </div>

    </div>

</body>

</html>