<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8" />
    <title>Invoice</title>

    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
            background-color: #f4f6f8;
        }

        .container {
            width: 600px;
            margin: 20px auto;
            background: #ffffff;
            padding: 20px;
            border-radius: 8px;
        }

        .header {
            text-align: center;
            border-bottom: 1px solid #ddd;
            padding-bottom: 15px;
        }

        .header h2 {
            margin: 0;
            color: #2c3e50;
        }

        .section {
            margin: 20px 0;
        }

        .section h3 {
            margin-bottom: 8px;
            color: #34495e;
        }

        .text {
            margin: 4px 0;
            color: #555;
        }

        .highlight {
            font-weight: bold;
        }

        .amount {
            font-size: 18px;
            font-weight: bold;
            color: #27ae60;
        }

        .button {
            display: inline-block;
            padding: 10px 15px;
            background-color: #3498db;
            color: #ffffff;
            text-decoration: none;
            border-radius: 5px;
            margin-top: 10px;
        }

        .footer {
            margin-top: 20px;
            border-top: 1px solid #ddd;
            text-align: center;
            padding-top: 10px;
            font-size: 13px;
            color: #999;
        }
    </style>
</head>

<body>

    <div class="container">

        <!-- Header -->
        <div class="header">
            <h2>Payment Invoice</h2>
            <p class="text">Invoice ID: <%= invoiceId %>
            </p>
        </div>

        <!-- Greeting -->
        <div class="section">
            <p class="text">
                Dear <span class="highlight">
                    <%= patientName %>
                </span>,
            </p>
            <p class="text">
                Your payment has been successfully completed. Below are your invoice details.
            </p>
        </div>

        <!-- Invoice Info -->
        <div class="section">
            <h3>Invoice Details</h3>
            <p class="text"><span class="highlight">Invoice ID:</span>
                <%= invoiceId %>
            </p>

            <% if (transactionId) { %>
                <p class="text"><span class="highlight">Transaction ID:</span>
                    <%= transactionId %>
                </p>
                <% } %>

                    <p class="text"><span class="highlight">Payment Date:</span>
                        <%= paymentDate %>
                    </p>
        </div>

        <!-- Patient & Doctor -->
        <div class="section">
            <h3>Appointment Information</h3>
            <p class="text"><span class="highlight">Patient:</span>
                <%= patientName %>
            </p>
            <p class="text"><span class="highlight">Doctor:</span> Dr. <%= doctorName %>
            </p>
            <p class="text"><span class="highlight">Appointment Date:</span>
                <%= appointmentDate %>
            </p>
        </div>

        <!-- Amount -->
        <div class="section">
            <h3>Payment Summary</h3>
            <p class="text amount">
                Total Paid: <%= amount %> BDT
            </p>
        </div>

        <!-- Download Button -->
        <div class="section">
            <% if (invoiceUrl) { %>
                <a href="<%= invoiceUrl %>" class="button">Download Invoice PDF</a>
                <% } %>
        </div>

        <!-- Footer -->
        <div class="footer">
            <p>This is an automated payment confirmation. Please do not reply.</p>
            <p>© <%= new Date().getFullYear() %> Cure Point Care Services</p>
        </div>

    </div>

</body>

</html>