model Appointment {
    id               String            @id @default(uuid(7))
    patientId        String
    doctorId         String
    doctorScheduleId String            @unique
    videoCallingId   String            @unique @db.Uuid()
    status           AppointmentStatus @default(SCHEDULED)
    paymentStatus    PaymentStatus     @default(UNPAID)
    createdAt        DateTime          @default(now())
    updatedAt        DateTime          @updatedAt

    // relations
    patient        Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
    doctor         Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
    doctorSchedule DoctorSchedule @relation(fields: [doctorScheduleId], references: [id], onDelete: Cascade)
    // One appointment can have one payment, review, prescription, and medical report
    payment        Payment?
    review         Review?
    prescription   Prescription?

    @@map("appointments")
}
